{
  "name": "@vlad-iakovlev/eslint-config",
  "version": "0.0.0",
  "description": "ESLint config for my projects",
  "homepage": "https://github.com/vlad-iakovlev/eslint-config#readme",
  "bugs": "https://github.com/vlad-iakovlev/eslint-config/issues",
  "repository": "https://github.com/vlad-iakovlev/eslint-config.git",
  "license": "MIT",
  "author": "Vladislav Iakovlev",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ci": "DEBUG=eslint:eslint eslint .",
    "prettier": "prettier --write '**/*.(ts|js|md|json)'",
    "prettier:ci": "prettier --check '**/*.(ts|js|md|json)'"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "typescript-eslint": "^8.66.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "grammy": "^1.45.1",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "lefthook@2.1.10": true
  }
}
